<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect canonical: http://www -> https://domeniu principal (301, o singura saritura)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^www\.ompriceput\.ro$ [NC]
    RewriteRule ^(.*)$ https://ompriceput.ro/$1 [R=301,L]

    # Redirect canonical: http -> https pe domeniul de productie (301)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^ompriceput\.ro$ [NC]
    RewriteRule ^(.*)$ https://ompriceput.ro/$1 [R=301,L]

    # Redirect canonical: de la www la domeniul principal (301)
    RewriteCond %{HTTP_HOST} ^www\.ompriceput\.ro$ [NC]
    RewriteRule ^(.*)$ https://ompriceput.ro/$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compresie (HTML, CSS, JS, JSON, SVG) - reduce substantial timpul de incarcare
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache: fisierele din /build sunt fingerprintate (schimbare = nume nou), branding-ul se revalideaza saptamanal
<IfModule mod_headers.c>
    # Securitate: clickjacking, MIME sniffing, politică de referrer, HSTS
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Strict-Transport-Security "max-age=15552000; includeSubDomains"

    SetEnvIf Request_URI "^/build/" IS_BUILD
    Header set Cache-Control "public, max-age=31536000, immutable" env=IS_BUILD

    SetEnvIf Request_URI "^/branding/" IS_BRANDING
    Header set Cache-Control "public, max-age=604800" env=IS_BRANDING
</IfModule>
